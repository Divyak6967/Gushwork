 document.addEventListener("DOMContentLoaded", () => {
   const mainHeader = document.getElementById("mainHeader");
   if (mainHeader) setupNav(mainHeader);
+
+  const carouselImage = document.getElementById("carouselImage");
+  const thumbsRoot = document.getElementById("carouselThumbs");
+  if (carouselImage && thumbsRoot) {
+    const images = [
+      "Asset/Frame-1.png",
+      "Asset/Frame-2.jpg",
+      "Asset/Frame-3.jpg",
+      "Asset/grid-2.jpg",
+      "Asset/grid-3.jpg",
+      "Asset/grid-4.jpg",
+    ];
+
+    let index = 0;
+
+    const renderThumbs = () => {
+      thumbsRoot.innerHTML = "";
+      images.forEach((src, i) => {
+        const btn = document.createElement("button");
+        btn.type = "button";
+        btn.className = "thumb";
+        btn.setAttribute("role", "listitem");
+        btn.setAttribute("aria-label", `View image ${i + 1}`);
+        btn.setAttribute("aria-current", i === index ? "true" : "false");
+
+        const img = document.createElement("img");
+        img.src = src;
+        img.alt = "";
+        img.loading = "lazy";
+        btn.appendChild(img);
+
+        btn.addEventListener("click", () => setIndex(i));
+        thumbsRoot.appendChild(btn);
+      });
+    };
+
+    const setIndex = (next) => {
+      index = (next + images.length) % images.length;
+      carouselImage.src = images[index];
+      renderThumbs();
+    };
+
+    const prevBtn = document.querySelector(".carousel-arrow--prev");
+    const nextBtn = document.querySelector(".carousel-arrow--next");
+
+    if (prevBtn) prevBtn.addEventListener("click", () => setIndex(index - 1));
+    if (nextBtn) nextBtn.addEventListener("click", () => setIndex(index + 1));
+
+    document.addEventListener("keydown", (e) => {
+      if (e.key === "ArrowLeft") setIndex(index - 1);
+      if (e.key === "ArrowRight") setIndex(index + 1);
+    });
+
+    setIndex(0);
+  }
 });
